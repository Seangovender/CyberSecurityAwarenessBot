<Window x:Class="CyberSecurityChatbot_Part2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Assistant" Height="650" Width="850"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen"
        MinWidth="800" MinHeight="600">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ASCII Art – crisp and full -->
        <Border Grid.Row="0" Background="#2C2C2C" CornerRadius="8" Margin="0,0,0,10" Padding="10">
            <Border Background="#1E1E1E" CornerRadius="4" Padding="8">
                <TextBlock FontFamily="Consolas" FontSize="12" Foreground="Cyan"
                           TextAlignment="Left" TextWrapping="NoWrap"
                           LineHeight="16" LineStackingStrategy="BlockLineHeight">
                    <Run Text="╔══════════════════════════════════════════════════════════════════╗" />
                    <LineBreak />
                    <Run Text="║   ____      _                              _ _                   ║" />
                    <LineBreak />
                    <Run Text="║  / ___|   _| |__   ___ _ __ ___  ___  ___ | (_)_ __              ║" />
                    <LineBreak />
                    <Run Text="║ | |  | | | | '_ \ / _ \ '__/ __|/ _ \/ _ \| | | '_ \             ║" />
                    <LineBreak />
                    <Run Text="║ | |__| |_| | |_) |  __/ |  \__ \  __/ (_) | | | | | |            ║" />
                    <LineBreak />
                    <Run Text="║  \____\__, |_.__/ \___|_|  |___/\___|\___/|_|_|_| |_|            ║" />
                    <LineBreak />
                    <Run Text="║       |___/                                                      ║" />
                    <LineBreak />
                    <Run Text="║        CYBERSECURITY AWARENESS ASSISTANT                         ║" />
                    <LineBreak />
                    <Run Text="╚══════════════════════════════════════════════════════════════════╝" />
                </TextBlock>
            </Border>
        </Border>

        <!-- Chat History ListBox -->
        <ListBox Grid.Row="1" x:Name="ChatHistory" Background="#121212" Foreground="#E0E0E0"
                 FontSize="14" BorderBrush="#3E3E3E" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,5"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Input Area -->
        <Border Grid.Row="2" Background="#2C2C2C" CornerRadius="8" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UserInputBox" Grid.Column="0" Background="#3E3E3E" Foreground="White"
                         BorderBrush="#555" BorderThickness="1" FontSize="14" Padding="8"
                         KeyDown="UserInputBox_KeyDown"/>
                <Button x:Name="SendButton" Grid.Column="1" Content="Send" Width="80" Margin="10,0,0,0"
                        Background="#007ACC" Foreground="White" FontWeight="Bold"
                        Click="SendButton_Click" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>